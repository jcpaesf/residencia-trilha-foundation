      "arn:aws:lambda:REGION:ACCOUNT_ID:function:ORDER_API_FUNCTION",
      "arn:aws:lambda:REGION:ACCOUNT_ID:function:ORDER_PROCESSOR_FUNCTION"
    ]
  }]
}
